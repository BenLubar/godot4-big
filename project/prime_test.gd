func TestProbablyPrime(t: TestingT) -> void:
	const nreps := 20
	for i in len(primes):
		var s := primes[i]
		var p := BigInt.new()
		p.SetString(s, 10)
		if not p.ProbablyPrime(nreps) or not p.ProbablyPrime(1) or not p.ProbablyPrime(0):
			t.Error("#%d prime found to be non-prime (%s)" % [i, s])

	for i in len(composites):
		var s := composites[i]
		var c := BigInt.new()
		c.SetString(s, 10)
		if c.ProbablyPrime(nreps) or c.ProbablyPrime(1) or c.ProbablyPrime(0):
			t.Error("#%d composite found to be prime (%s)" % [i, s])

func BenchmarkProbablyPrime(b0: TestingB) -> void:
	var p := BigInt.new()
	p.SetString("", 10)
	for n in [0, 1, 5, 10, 20]:
		b0.Run("n=%d" % [n], func(b: TestingB) -> void:
			for i in b.N:
				p.ProbablyPrime(n))

	b0.Run("Lucas", func(b: TestingB) -> void:
		for i in b.N:
			BigInt._probablyPrimeLucas(p._abs))

	b0.Run("MillerRabinBase2", func(b: TestingB) -> void:
		for i in b.N:
			BigInt._probablyPrimeMillerRabin(p._abs, 1, true))

func TestMillerRabinPseudoprimes(t: TestingT) -> void:
	testPseudoprimes(t, "probablyPrimeMillerRabin",
		func(n: PackedInt64Array) -> bool:
			return BigInt._probablyPrimeMillerRabin(n, 1, true) and not BigInt._probablyPrimeLucas(n),
		# https://oeis.org/A001262
		[2047, 3277, 4033, 4681, 8321, 15841, 29341, 42799, 49141, 52633, 65281, 74665, 80581, 85489, 88357, 90751])

func TestLucasPseudoprimes(t: TestingT) -> void:
	testPseudoprimes(t, "probablyPrimeLucas",
		func(n: PackedInt64Array) -> bool:
			return BigInt._probablyPrimeLucas(n) and not BigInt._probablyPrimeMillerRabin(n, 1, true),
		# https://oeis.org/A217719
		[989, 3239, 5777, 10877, 27971, 29681, 30739, 31631, 39059, 72389, 73919, 75077])

func testPseudoprimes(t: TestingT, name: String, cond: Callable, want: PackedInt64Array) -> void:
	var n: PackedInt64Array = [1]
	for i in range(3, 100000, 2):
		n[0] = i
		var pseudo: bool = cond.call(n)
		if pseudo and (want.is_empty() or i != want[0]):
			t.Error("%s(%d, base=2) = true, want false" % [name, i])
		elif not pseudo and len(want) >= 1 and i == want[0]:
			t.Error("%s(%d, base=2) = false, want true" % [name, i])

		if not want.is_empty() and i == want[0]:
			want.remove_at(0)

	if len(want) > 0:
		t.Error("forgot to test %s" % [want])
